{
  "name": "@clack120/laftel",
  "version": "0.2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./drm": {
      "types": "./dist/drm.d.ts",
      "default": "./dist/drm.js"
    },
    "./payments": {
      "types": "./dist/payments.d.ts",
      "default": "./dist/payments.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build-package.mjs npm",
    "build:jsr": "node scripts/build-package.mjs jsr",
    "publish:jsr": "npm run build:jsr && cd build/jsr && deno publish --allow-dirty",
    "check": "deno check src/mod.ts src/drm.ts src/payments.ts",
    "gen:constants": "deno run --allow-net --allow-write=src scripts/gen-constants.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "license": "Unlicense"
}
