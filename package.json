{
  "name": "@clack120/laftel",
  "description": "비공식 라프텔 TypeScript SDK",
  "version": "0.2.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./drm": {
      "types": "./dist/drm.d.ts",
      "default": "./dist/drm.js"
    },
    "./payments": {
      "types": "./dist/payments.d.ts",
      "default": "./dist/payments.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "gen:constants": "npm run build && node scripts/gen-constants.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "license": "Unlicense"
}
